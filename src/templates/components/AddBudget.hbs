<div class="overlay" id="budjetsPopup" style="display: none;">
    <div class="popup-form">
        <button class="close-btn" id="close-btn-budget">×</button>
        <h2>Запланировать бюджет</h2>
        <form class="create-category-form" id="categoryForm">

            <div class="input-group" id="date-create-budgets">
                <input type="date" placeholder="Введите дату" name="planDate" required/>
            </div>

            <div class="input-group" id="text-create-budgets" >
                <input type="text" name="planSum" placeholder="Введите планируемый баланс" required/>
            </div>

            <button type="submit" class="submit-btn-cat" id="submit-budget">Запланировать</button>
        </form>
    </div>
</div>
