<div class="cards">
  {{#if (not is_empty)}}
  <div class="card1">
    <h3 class="Card-One-text">Счет №{{id}}</h3>
    <div class="CheckSumCard">
      <h2>{{balance}} ₽</h2>
    </div>
  </div>
  {{else}}
  <div class="card1">
    <div class="cards_not_exist">
      <a class="add_cards" href="#">+ Добавить счет</a>
    </div>
  </div>
  {{/if}}
</div>
