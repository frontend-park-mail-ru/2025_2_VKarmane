<div class="Plan-Balance">
  {{#if (not is_empty)}}
  <h3 class="Fact-Plan-text">Планируемый</h3>
  <div class="CheckSum" id="planCheckSum">
    <h2 class="PlanSum">{{PlanSum}} ₽</h2>
      <h3 class="PlanDate">Запланировано на: {{PlanDate}}</h3>
      <p class="PlanID" style="display: none">{{PlanID}}</p>
  </div>
      <div class="plan-settings" id="plan-settings">
          <div class="popup-menu" id="plan-settings-popup">
              <button class="edit-btn">
                  Редактировать <img src="/imgs/RedactButtonImg.svg" alt="" />
              </button>
              <button class="delete-btn">
                  Удалить <img src="/imgs/DeleteButtonImg.svg" alt="" />
              </button>
          </div>
      </div>
  {{else}}
  <div class="balance_not_exists_plan">
      <button class="AddPlanBudgets" id="PlanBttn">
          Запланировать бюджет
      </button>
  </div>
  {{/if}}
</div>
