<div class="overlay" id="budjetsPopupEdit" style="display: none;">
    <div class="popup-form">
        <button class="close-btn" id="close-btn-budget-edit">×</button>
        <h2>Редактировать бюджет</h2>
        <form class="edit-category-form" id="BudgetEditForm">

            <div class="input-group" id="date-edit-budgets">
                <input type="date" placeholder="Введите дату" name="planDate" required/>
            </div>

            <div class="input-group" id="text-edit-budgets" >
                <input type="text" name="planSum" placeholder="Введите планируемый баланс" required/>
            </div>

            <button type="submit" class="submit-btn-cat" id="submit-budget-edit">Редактировать</button>
        </form>
    </div>
</div>
